{
  "name": "axon",
  "version": "2.0.0-beta",
  "private": true,
  "description": "Desktop AI workspace powered by OmniRoute.",
  "author": "xdxegit <noreply@axon.studio>",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dist": "npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis --x64",
    "portable": "npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable --x64",
    "dist:setup": "npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis --x64 && cd installer && npm install && npm run dist",
    "dist:cross:linux": "npm run build && electron-builder --config build/electron-builder.cross.json --linux",
    "dist:cross:mac": "npm run build && electron-builder --config build/electron-builder.cross.json --mac",
    "dist:cross": "npm run build && electron-builder --config build/electron-builder.cross.json --linux --mac",
    "dist:auto": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "local.axon.studio",
    "productName": "Axon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Axon",
      "runAfterFinish": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "linux": {
      "category": "Utility",
      "maintainer": "xdxegit <noreply@axon.studio>",
      "synopsis": "Desktop AI workspace powered by OmniRoute.",
      "desktop": {
        "entry": {
          "StartupWMClass": "Axon"
        }
      },
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] },
        { "target": "tar.gz", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
