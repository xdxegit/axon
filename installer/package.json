{
  "name": "axon-glow",
  "version": "2.0.0-beta",
  "private": true,
  "description": "Axon Glow — the installer for Axon.",
  "author": "xdxegit <noreply@axon.studio>",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\prebuild.ps1 && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable --x64",
    "dist:auto": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "local.axon.glow",
    "productName": "Axon Glow",
    "asar": true,
    "directories": {
      "output": "../release-installer-${version}"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "index.html",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": false,
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "Axon-Glow-${version}.${ext}",
      "extraResources": [
        { "from": "../release/Axon-x64.exe", "to": "nsis.exe" },
        { "from": "build/icon.ico", "to": "icon.ico" }
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "Axon-Glow-${version}-mac-${arch}.${ext}",
      "extraResources": [
        { "from": "../release", "to": "payload", "filter": ["*.dmg"] }
      ]
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icons",
      "maintainer": "xdxegit <noreply@axon.studio>",
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "artifactName": "Axon-Glow-${version}-linux-${arch}.${ext}",
      "extraResources": [
        { "from": "../release", "to": "payload", "filter": ["*.deb", "*.AppImage"] }
      ]
    }
  }
}
